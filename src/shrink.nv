// shrink.nv — shrinking as arithmetic on the transcript, as a walk the
// runner drives.
//
// The model is Hypothesis's.  A candidate is a shorter or
// lexicographically smaller transcript, replayed through the same
// strategy.  proptest's model, a tree of simplifications per value,
// needs a named type per combinator and a trait object to hold them,
// which this language cannot give a package that declares no effects.
// One walk shrinks every strategy, `flat_map` included, because the
// transcript is a flat list and does not record which strategy read
// which part.
//
// A shrink is minimal in the transcript, not necessarily in the value;
// Hypothesis states the same limit.
//
// Nothing here calls a property.  The runner drives the walk:
//
//     var p = shrink.plan_from(failing_choices)
//     while not shrink.is_done(p)
//         let Some(t) = shrink.next_try(p) else break
//         // the runner replays t.candidate and judges the value
//         p = if still_fails then shrink.keep(p, t) else shrink.reject(p, t)
//
// No function here has an effect.

// A named reduction, tried against the transcript in this order.
//
// The order is Hypothesis's and it is not arbitrary: deleting comes
// first because removing a span makes every later pass cheaper, and
// the two lowering passes come last because they are the ones that
// make progress in single steps.
//
// ```novo
// use shrink
//
// fn main() [io]
//     println(shrink.pass_name(PassDeleteSpan))
// ```
pub enum ShrinkPass
    // Remove a run of choices, and also try it with the choice just
    // before the run lowered by one, which is what removing a list's
    // element does to the list's length.  Shortens a list, empties a
    // string.  Spans are tried longest first: the whole transcript,
    // then runs of 8, 4, 3, 2 and 1.
    PassDeleteSpan
    // Set one choice to 0.  Takes an integer to its range's low end, a
    // boolean to false, a branch to the first one.
    PassZeroChoice
    // Halve one choice.  Gets a large number small in a logarithmic
    // number of steps, where zeroing would either work at once or not
    // at all.
    PassHalveChoice
    // Lower one choice by the largest power of two that still fails,
    // then the next smaller, which is a binary search between 0 and its
    // value.  Finds the exact boundary a property breaks at.
    PassLowerChoice
    // Sort a run of choices ascending, for runs of the whole
    // transcript, 8, 4, 3 and 2.  A list whose failure does not depend
    // on order becomes a sorted list.
    PassSortSpan
    // Replace a run with an earlier run of the same length that it
    // does not overlap.  Makes repeated structure identical: three
    // different names in a list become the same name three times.
    PassDedupeSpan

// The state of a shrink walk.
//
// ```novo
// use shrink
//
// fn main() [io]
//     println("${shrink.is_done(shrink.plan_from([]))}")
// ```
pub struct ShrinkPlan
    // The shortest, smallest transcript known to still fail.  Starts
    // as the one the failing case produced and only ever improves.
    best: [Int]
    // Which pass is being tried, as an index into `passes()`.
    at_pass: Int
    // Which move of the pass is next.
    index: Int
    // How many candidates have been accepted.
    shrinks: Int
    // How many candidates have been offered.  The runner's budget is
    // measured against this, so a walk that stops making progress
    // stops costing time.
    tried: Int
    // Whether every pass has run to the end with nothing accepted.
    done: Bool
    // How many candidates had been accepted when the current round of
    // passes began.  A round that ends with more starts another.
    round_start: Int

// One candidate for the runner to judge.
//
// ```novo
// use shrink
//
// fn main() [io]
//     match shrink.next_try(shrink.plan_from([5, 5]))
//         Some(t) => println(shrink.pass_name(t.by_pass))
//         None    => println("nothing left to try")
// ```
pub struct ShrinkTry
    // The transcript to replay.
    candidate: [Int]
    // Which pass produced it, so a runner can report — or trace —
    // which reduction did the work.
    by_pass: ShrinkPass
    // Where in the transcript it applied.
    at: Int

// The passes, in the order they are tried.
//
// `pub` because the order is part of the contract: a caller
// reproducing a shrink by hand, or writing a test about one, needs the
// same sequence.
//
// ```novo
// use shrink
// use std.list
//
// fn main() [io]
//     println("${list.len(shrink.passes())}")
// ```
pub fn passes() -> [ShrinkPass]
    [PassDeleteSpan, PassZeroChoice, PassHalveChoice, PassLowerChoice, PassSortSpan,
     PassDedupeSpan]

// A pass's name: `"delete span"`, `"zero choice"`, `"halve choice"`,
// `"lower choice"`, `"sort span"`, `"dedupe span"`.
//
// ```novo
// use shrink
//
// fn main() [io]
//     println(shrink.pass_name(PassHalveChoice))
// ```
pub fn pass_name(p: ShrinkPass) -> Str
    match p
        PassDeleteSpan  => "delete span"
        PassZeroChoice  => "zero choice"
        PassHalveChoice => "halve choice"
        PassLowerChoice => "lower choice"
        PassSortSpan    => "sort span"
        PassDedupeSpan  => "dedupe span"

// A walk over a failing transcript.
//
// ```novo
// use shrink
//
// fn main() [io]
//     println("${shrink.shrinks_of(shrink.plan_from([5, 5, 5]))}")
// ```
pub fn plan_from(failing: [Int]) -> ShrinkPlan
    let p = ShrinkPlan { best: failing, at_pass: 0, index: 0, shrinks: 0, tried: 0, done: false,
                         round_start: 0 }
    with_done(p)

// The next candidate, or `None` when the walk is finished.
//
// The runner replays the candidate and answers with `keep` or
// `reject`.  Calling this twice without answering gives the same
// candidate both times — the plan does not advance until it is told
// what happened, which is what makes the walk resumable and testable.
//
// ```novo
// use shrink
//
// fn main() [io]
//     match shrink.next_try(shrink.plan_from([5]))
//         Some(t) => println("${t.at}")
//         None    => println("already minimal")
// ```
pub fn next_try(p: ShrinkPlan) -> ?ShrinkTry
    match search(p)
        Some(f) => Some(ShrinkTry { candidate: f.candidate, by_pass: passes()[f.pass_at], at: f.at })
        None    => None

// The candidate still failed: take it, and carry on from there.
//
// The move is retried at the same position, because a reduction that
// worked once often works again.  `t` is normally the try `next_try`
// offered; a runner may hand back instead a try whose `candidate` is the
// transcript its replay consumed, which drops choices the strategy
// never read and reduces each choice below its bound.  A candidate that
// is not simpler than the best is not taken, and the accepted count
// still grows.
//
// ```novo
// use shrink
//
// fn main() [io]
//     match shrink.next_try(shrink.plan_from([5]))
//         Some(t) => println("${shrink.shrinks_of(shrink.keep(shrink.plan_from([5]), t))}")
//         None    => println("already minimal")
// ```
pub fn keep(p: ShrinkPlan, t: ShrinkTry) -> ShrinkPlan
    let Some(f) = search(p) else return p
    let best = if simpler_than(t.candidate, p.best)
        t.candidate
    else
        p.best
    let round = if f.wrapped
        p.shrinks
    else
        p.round_start
    with_done(ShrinkPlan { best: best, at_pass: f.pass_at, index: f.move, shrinks: p.shrinks + 1,
                           tried: p.tried + 1, done: false, round_start: round })

// The candidate passed, or was discarded: move on.
//
// A candidate that overran is rejected the same way, which is the
// point of `tape.is_overrun`: a transcript too short for the strategy
// produces a value made of zeros, and a property that fails on that
// has not failed on anything the strategy can generate.
//
// ```novo
// use shrink
//
// fn main() [io]
//     match shrink.next_try(shrink.plan_from([5]))
//         Some(t) => println("${shrink.is_done(shrink.reject(shrink.plan_from([5]), t))}")
//         None    => println("already minimal")
// ```
pub fn reject(p: ShrinkPlan, t: ShrinkTry) -> ShrinkPlan
    let Some(f) = search(p) else return p
    let round = if f.wrapped
        p.shrinks
    else
        p.round_start
    with_done(ShrinkPlan { best: p.best, at_pass: f.pass_at, index: f.move + 1, shrinks: p.shrinks,
                           tried: p.tried + 1, done: false, round_start: round })

// The best transcript found.
//
// ```novo
// use shrink
// use std.list
//
// fn main() [io]
//     println("${list.len(shrink.best_of(shrink.plan_from([5, 5])))}")
// ```
pub fn best_of(p: ShrinkPlan) -> [Int]
    list.clone(p.best)

// How many candidates have been accepted.
//
// ```novo
// use shrink
//
// fn main() [io]
//     println("${shrink.shrinks_of(shrink.plan_from([5]))}")
// ```
pub fn shrinks_of(p: ShrinkPlan) -> Int
    p.shrinks

// How many candidates have been offered.
//
// What a runner's budget is measured against.
//
// ```novo
// use shrink
//
// fn main() [io]
//     println("${shrink.tried_of(shrink.plan_from([5]))}")
// ```
pub fn tried_of(p: ShrinkPlan) -> Int
    p.tried

// Whether every pass has run with nothing accepted.
//
// ```novo
// use shrink
//
// fn main() [io]
//     println("${shrink.is_done(shrink.plan_from([]))}")
// ```
pub fn is_done(p: ShrinkPlan) -> Bool
    p.done

// Whether one transcript is simpler than another under the order this
// walk minimises.
//
// Shorter first, then lexicographically smaller.  The whole
// ordering in one function, `pub` so that a test can assert a shrink
// made progress without reimplementing the comparison, and so that a
// reader who wants to know what "minimal" means here can read it
// rather than infer it from six passes.
//
// ```novo
// use shrink
//
// fn main() [io]
//     println("${shrink.simpler_than([1], [1, 1])}")
// ```
pub fn simpler_than(a: [Int], b: [Int]) -> Bool
    let na = list.len(a)
    let nb = list.len(b)
    if na != nb
        return na < nb
    for i in 0..na
        if a[i] != b[i]
            return a[i] < b[i]
    false

// How many passes there are: `passes()` has this many entries.
fn pass_count() -> Int
    6

// A candidate a search found: the pass as an index into `passes()`,
// the move number inside the pass, the transcript position the move
// applies at, the candidate, and whether the search had to start a new
// round of passes to find it.
struct Found
    pass_at: Int
    move: Int
    at: Int
    candidate: [Int]
    wrapped: Bool

// The plan with `done` set when no candidate is left.
fn with_done(p: ShrinkPlan) -> ShrinkPlan
    ShrinkPlan { best: p.best, at_pass: p.at_pass, index: p.index, shrinks: p.shrinks,
                 tried: p.tried, done: search(p) == None, round_start: p.round_start }

// The next candidate from the plan's position: the rest of this round,
// then, if this round accepted anything, one more round from the start.
fn search(p: ShrinkPlan) -> ?Found
    if let Some(f) = search_from(p.best, p.at_pass, p.index, false)
        return Some(f)
    if p.shrinks > p.round_start
        return search_from(p.best, 0, 0, true)
    None

// The first move from pass `first`, move `move` on whose candidate is
// simpler than `best`.
fn search_from(best: [Int], first: Int, move: Int, wrapped: Bool) -> ?Found
    for pi in first..pass_count()
        let from = if pi == first
            move
        else
            0
        for mi in from..move_count(pi, list.len(best))
            if let Some((at, cand)) = candidate(pi, mi, best)
                if simpler_than(cand, best)
                    return Some(Found { pass_at: pi, move: mi, at: at, candidate: cand,
                                        wrapped: wrapped })
    None

// The span sizes a pass tries on a transcript of length `n`, longest
// first: the whole transcript, then 8, 4, 3, 2 and 1.
fn span_sizes(n: Int, smallest: Int) -> [Int]
    var out: [Int] = []
    for size in [n, 8, 4, 3, 2, 1]
        if size <= n and size >= smallest and not list.contains(out, size)
            list.push(out, size)
    out

// How many moves pass `which` has on a transcript of length `n`.
fn move_count(which: Int, n: Int) -> Int
    if which == 0
        return 2 * list.sum(list.map(span_sizes(n, 1), size => n - size + 1))
    if which == 4
        return list.sum(list.map(span_sizes(n, 2), size => n - size + 1))
    if which == 5
        return list.sum(list.map(span_sizes(n / 2, 1), size => dedupe_count(n, size)))
    if which == 3
        return n * 63
    n

// How many ways a run of `size` can be copied over a later run that
// does not overlap it, on a transcript of length `n`.
fn dedupe_count(n: Int, size: Int) -> Int
    var total = 0
    for s in size..n - size + 1
        total = total + s - size + 1
    total

// The move `move` of pass `which` on `best`: where it applies and the
// transcript it gives, or `None` for a lowering step larger than the
// value it would lower.
fn candidate(which: Int, move: Int, best: [Int]) -> ?(Int, [Int])
    let n = list.len(best)
    if which == 0
        return Some(delete_move(best, move))
    if which == 1
        return Some((move, with_value(best, move, 0)))
    if which == 2
        return Some((move, with_value(best, move, best[move] / 2)))
    if which == 3
        let i = move / 63
        let step = 1 << (62 - move % 63)
        let v = best[i]
        if step > v
            return None
        return Some((i, with_value(best, i, v - step)))
    if which == 4
        return Some(sort_move(best, move))
    Some(dedupe_move(best, move, n))

fn with_value(best: [Int], i: Int, v: Int) -> [Int]
    var out = list.clone(best)
    out[i] = v
    out

// The span of `size` at `start` that move number `move` names, over
// the sizes `sizes` on a transcript of length `n`: the moves run
// through every start of the first size, then of the second.
fn span_at(sizes: [Int], n: Int, move: Int) -> (Int, Int)
    var left = move
    var k = 0
    while left >= n - sizes[k] + 1 and k < list.len(sizes) - 1
        left = left - (n - sizes[k] + 1)
        k = k + 1
    (sizes[k], left)

// Even moves delete the span; odd moves delete it and lower the choice
// before it by one, which is what removing one element of a list also
// needs done to the list's length.
fn delete_move(best: [Int], move: Int) -> (Int, [Int])
    let n = list.len(best)
    let (size, start) = span_at(span_sizes(n, 1), n, move / 2)
    let rest = list.concat(best[:start], best[start + size:])
    if move % 2 == 0 or start == 0 or best[start - 1] <= 0
        return (start, rest)
    (start, with_value(rest, start - 1, best[start - 1] - 1))

fn sort_move(best: [Int], move: Int) -> (Int, [Int])
    let n = list.len(best)
    let (size, start) = span_at(span_sizes(n, 2), n, move)
    var run = best[start:start + size]
    list.sort(run)
    (start, list.concat(list.concat(best[:start], run), best[start + size:]))

// Copies a run over a later run of the same size that it does not
// overlap.  The moves run through the sizes, then the later run's
// start, then the earlier run's start.
fn dedupe_move(best: [Int], move: Int, n: Int) -> (Int, [Int])
    let sizes = span_sizes(n / 2, 1)
    var left = move
    var k = 0
    while left >= dedupe_count(n, sizes[k]) and k < list.len(sizes) - 1
        left = left - dedupe_count(n, sizes[k])
        k = k + 1
    let size = sizes[k]
    var to = size
    while left >= to - size + 1
        left = left - (to - size + 1)
        to = to + 1
    let run = best[left:left + size]
    (to, list.concat(list.concat(best[:to], run), best[to + size:]))
